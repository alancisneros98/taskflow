@baseUrl = http://localhost:3000

### 1. Registrar usuario A
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Juan",
  "email": "juan@test.com",
  "password": "123456"
}

### 2. Registrar usuario B
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Pedro",
  "email": "pedro@test.com",
  "password": "123456"
}

### 3. Login A (guarda el token en una variable)
# @name loginA
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "juan@test.com",
  "password": "123456"
}

### 4. Login B
# @name loginB
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "pedro@test.com",
  "password": "123456"
}

### 5. A crea una tarea
@tokenA = {{loginA.response.body.token}}
POST {{baseUrl}}/api/tasks
Content-Type: application/json
Authorization: Bearer {{tokenA}}

{
  "title": "Tarea privada de A",
  "description": "Solo A debe verla"
}

### 6. A ve sus tareas
GET {{baseUrl}}/api/tasks
Authorization: Bearer {{tokenA}}

### 7. B ve sus tareas (debe ser lista vacía)
@tokenB = {{loginB.response.body.token}}
GET {{baseUrl}}/api/tasks
Authorization: Bearer {{tokenB}}

### 8. B intenta leer la tarea de A (debe dar 404)
GET {{baseUrl}}/api/tasks/1
Authorization: Bearer {{tokenB}}

### 9. B intenta borrar la tarea de A (debe dar 404)
DELETE {{baseUrl}}/api/tasks/1
Authorization: Bearer {{tokenB}}

### 10. Sin token (debe dar 401)
GET {{baseUrl}}/api/tasks